__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.DS_Store

# Keep the supplied input data and new generated output files out of Git.
# The example outputs already committed under out/ remain tracked.
data/*.csv
out/*.csv
out/*.jsonl
out/*.json

# but keep the directories
!data/.gitkeep
!out/.gitkeep
